{
  "name": "@archivo/web",
  "version": "0.5.0",
  "description": "Archivo web application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:subdir": "cross-env VITE_BASE_URL=/archivo/ tsc -b && cross-env VITE_BASE_URL=/archivo/ vite build",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@archivo/file-operations": "workspace:*",
    "@archivo/shared": "workspace:*",
    "@archivo/ui": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^5.4.530",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "rimraf": "^6.1.2",
    "sass": "^1.97.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
